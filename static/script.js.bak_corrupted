    } else if (objDistance) {

        stableSortByScore((c) => (1 / c.avgDistance) * 0.7 + c.radiusFactor * 0.3);

    } else if (objBalance) {

        stableSortByScore((c) => c.capacity * 0.7 + c.radiusFactor * 0.3);

    } else {

