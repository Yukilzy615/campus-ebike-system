async function computeSupplyDemandData(timeSlot, preferredScheme) {
    const resolved = resolveSupplyDemandScheme(preferredScheme);
    const activeScheme = resolved.scheme;
    const targetMarkers = resolved.markers;

    if (!targetMarkers || targetMarkers.length === 0) {
        return { activeScheme, rows: [], dispatchPoints: [] };
    }

    const cacheKey = buildSupplyDemandCacheKey(timeSlot, activeScheme, targetMarkers);
    if (supplyDemandCalcCache[cacheKey]) {
        return supplyDemandCalcCache[cacheKey];
    }

    const rules = {
        morning: { '宿舍': -1.2, '教学楼': 1.0, '食堂': 0.3, '图书馆': 0.2, '校门': 0.3, '其他': 0.1 },
        noon: { '宿舍': 0.4, '教学楼': -0.6, '食堂': -0.8, '图书馆': 0.1, '校门': 0.0, '其他': 0.2 },
        evening: { '宿舍': -1.0, '教学楼': 0.8, '食堂': 0.3, '图书馆': 0.1, '校门': 0.0, '其他': 0.4 }
    };
    const rule = rules[timeSlot] || rules.morning;

    const refPOIs = getSupplyDemandReferencePOIs();
    const siteDrafts = [];
    let totalDemand = 0;

    targetMarkers.forEach((markerObj, index) => {
        const ll = getMarkerLatLng(markerObj);
        if (!ll) {
            return;
        }

        let netFlowScore = 0;
        refPOIs.forEach((poi) => {
            const dist = Math.hypot(ll.lng - poi.lng, ll.lat - poi.lat) * 111000;
            if (dist < 350) {
                const weight = 1.0 / Math.max(15, dist);
                netFlowScore += weight * (rule[poi.category] || 0);
            }
        });

        const baseDemand = 16 + ((index * 3) % 18);
        totalDemand += baseDemand;

        siteDrafts.push({
            index,
            lat: ll.lat,
            lng: ll.lng,
            name: `${activeScheme === 'smart' ? '智能点' : '人工点'}${index + 1}`,
            demand: baseDemand,
            score: netFlowScore
        });
    });

    if (siteDrafts.length === 0) {
        const empty = { activeScheme, rows: [], dispatchPoints: [] };
        supplyDemandCalcCache[cacheKey] = empty;
        return empty;
    }

    const targetTotalSupply = totalDemand * 1.05;
    siteDrafts.forEach((s) => {
        s.rawSupply = s.demand + s.score * 140;
    });

    const currentTotalSupply = siteDrafts.reduce((sum, s) => sum + s.rawSupply, 0);
    const safeTotalSupply = Math.abs(currentTotalSupply) < 1e-6 ? 1 : currentTotalSupply;
    const globalScale = targetTotalSupply / safeTotalSupply;

    const rows = siteDrafts.map((s) => {
        const current = Math.max(2, Math.round(s.rawSupply * globalScale));
        const transfer = s.demand - current;

        let status = 'balanced';
        if (transfer > 2) {
            status = 'shortage';
        } else if (transfer < -2) {
            status = 'surplus';
        }

        return {
            idx: s.index,
            name: s.name,
            current,
            demand: s.demand,
            transfer,
            status,
            lat: s.lat,
            lng: s.lng
        };
    });

    const dispatchPoints = rows
        .filter((item) => item.transfer !== 0)
        .map((item) => ({
            id: `${activeScheme}-${item.idx + 1}`,
            lat: item.lat,
            lng: item.lng,
            type: activeScheme,
            amount: Math.abs(item.transfer),
            demand_type: item.transfer > 0 ? 1 : -1,
            transfer: item.transfer,
            name: item.name
        }));

    const result = { activeScheme, rows, dispatchPoints };
    supplyDemandCalcCache[cacheKey] = result;
    return result;
}







// 生成供需状态桨常


function generateSupplyDemandTable(timeSlot) {



    console.log('generateSupplyDemandTable called with timeSlot:', timeSlot);







    const effectiveScheme = getEffectiveScheme();
    const markers = effectiveScheme === 'smart' ? smartMarkers : manualMarkers;



    // 需求模拟规则（早高峰、午高峰、晚高峰）
    // 早高峰：宿舍 → 教学楼（权重 0.7），宿舍 → 食堂（0.1），宿舍 → 其他（0.2）
    // 午高峰：教学楼 → 食堂（0.6），教学楼 → 宿舍（0.2），其他 → 食堂（0.2）
    // 晚高峰：教学楼 → 宿舍（0.7），食堂 → 宿舍（0.2），其他 → 宿舍（0.1）
    
    const zoneRules = {
        'morning': {
            'dorm_main': 1.0, 'dorm_secondary': 0.8, 'teaching_main': -0.7,
            'teaching_secondary': -0.5, 'canteen': -0.1, 'library': -0.3, 'other': -0.2
        },
        'noon': {
            'dorm_main': -0.2, 'dorm_secondary': -0.1, 'teaching_main': 0.5,
            'teaching_secondary': 0.3, 'canteen': -0.6, 'library': 0.2, 'other': -0.2
        },
        'evening': {
            'dorm_main': -0.9, 'dorm_secondary': -0.7, 'teaching_main': 0.6,
            'teaching_secondary': 0.4, 'canteen': -0.2, 'library': -0.1, 'other': -0.1
        }
    };

    // POI类别中心坐标（基于武汉大学信息学部实际POI分布）
    const zones = {
        'dorm_main': { coords: [114.3658, 30.5339], category: '宿舍', weight: 1.0 },
        'dorm_secondary': { coords: [114.3637, 30.5338], category: '宿舍', weight: 0.8 },
        'dorm_third': { coords: [114.3654, 30.5331], category: '宿舍', weight: 0.7 },
        'teaching_main': { coords: [114.3660, 30.5317], category: '教学楼', weight: 0.9 },
        'teaching_secondary': { coords: [114.3679, 30.5313], category: '教学楼', weight: 0.6 },
        'teaching_third': { coords: [114.3658, 30.5312], category: '教学楼', weight: 0.5 },
        'canteen_main': { coords: [114.3648, 30.5336], category: '食堂', weight: 0.9 },
        'canteen_secondary': { coords: [114.3648, 30.5325], category: '食堂', weight: 0.7 },
        'canteen_third': { coords: [114.3662, 30.5357], category: '食堂', weight: 0.6 },
        'library': { coords: [114.3668, 30.5341], category: '图书馆', weight: 0.5 },
        'other': { coords: [114.3665, 30.5320], category: '其他', weight: 0.2 }
    };
    
    const rule = zoneRules[timeSlot] || zoneRules['morning'];

    const tbody = document.getElementById('supply-demand-body');



    if (!tbody) return;







    if (markers.length === 0) {



        tbody.innerHTML = '<tr><td colspan="5" style="color:#999;padding:20px;">请先运行选址算法</td></tr>';



        return;



    }







    let tableHTML = '';



    markers.forEach((item, idx) => {



        let lat, lng;



        if (item.marker && typeof item.marker.getPosition === 'function') {



            const pos = item.marker.getPosition();



            lat = pos.lat;



            lng = pos.lng;



        } else {



            lat = item.lat;



            lng = item.lng;



        }







        let totalWeight = 0;
        let netFlow = 0;

        for (const [zoneName, zoneData] of Object.entries(zones)) {
            const [zoneLng, zoneLat] = zoneData.coords;
            const zoneWeight = zoneData.weight || 1.0;
            const distance = Math.max(1, Math.hypot(lng - zoneLng, lat - zoneLat) * 111000);
            const weight = (1.0 / distance) * zoneWeight;
            totalWeight += weight;
            netFlow += weight * (rule[zoneName] || 0);
        }



        netFlow = totalWeight > 0 ? netFlow / totalWeight : 0;







        const amount = Math.abs(Math.round(netFlow * 100));



        const type = netFlow > 0 ? 1 : -1;



